# admin.api's environment. Copy to .env (it isn't committed): Nx loads it
# for `nx serve admin.api`. In production these come from the container's
# environment.

# The configuration file. Relative to the workspace root.
CONFIG_PATH=.mount/cfg/admin-api-configuration.json
PORT=3000

# Secret.
# MongoDB connection, with the login and password. The same database as
# mobile.api: the admin panel writes the boards the game reads.
MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin
