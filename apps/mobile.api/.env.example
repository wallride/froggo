# mobile.api's environment. Copy to .env (it isn't committed) and fill in:
# Nx loads it for `nx serve mobile.api`. In production these come from the
# container's environment and secrets, never from a file in the repository.
#
# The content configuration (texts, avatars, limits) is not here: it ships with
# the release, next to main.js.

# Overrides the content configuration file. Optional: by default the app reads
# "configuration.json" next to main.js (in the release). Locally — the
# workspace template.
CONFIG_PATH=.mount/cfg/mobile-api-configuration.json
PORT=3001

# Secrets.
# MongoDB connection, with the login and password.
MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin
# At least 32 random characters, e.g. from `openssl rand -hex 32`.
# Changing it signs every player out.
AUTH_TOKEN_SECRET=

# The oldest app release allowed to use the API. A build below it (or a request
# that doesn't say its version) gets 426 and shows the update alert.
MINIMUM_APP_VERSION=1.0.0

# Where the asset files (avatars) are. In the release — "assets" next to
# main.js, which is the default; locally — the workspace's.
ASSETS_ROOT_PATH=.mount/assets

# Where the app should load the files from instead, if not the API itself
# (a CDN, a reverse proxy): https://cdn.example.com/assets
# ASSETS_PUBLIC_BASE_URL=

# Allowed CORS origins for the mobile app's web target, comma-separated.
# Omit to allow any origin (fine locally, set it in production).
# CORS_ALLOWED_ORIGINS=https://example.com
