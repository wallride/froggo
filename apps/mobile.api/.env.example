# mobile.api's environment. Copy to .env (it isn't committed) and fill in:
# Nx loads it for `nx serve mobile.api`. In production these come from the
# container's environment and secrets, never from a file in the repository.

# The configuration file (no secrets in it). Relative to the workspace root.
CONFIG_PATH=.mount/cfg/mobile-api-configuration.json
PORT=3001

# Secrets.
# MongoDB connection, with the login and password.
MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin
# At least 32 random characters, e.g. from `openssl rand -hex 32`.
# Changing it signs every player out.
AUTH_TOKEN_SECRET=
